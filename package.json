{
  "name": "petad",
  "private": true,
  "version": "0.0.0",
  "license": "MIT-0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:msw && tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "check:msw": "node scripts/check-msw-production.mjs --mode production",
    "lint": "eslint . && node scripts/check-query-keys.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.45.9",
    "@stellar/freighter-api": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.0",
    "type-fest": "^5.10.0",
    "undici": "^8.1.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
