// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DisputeStatusBadge > Snapshots for all statuses > matches snapshot for CLOSED 1`] = `
<span
  aria-label="Closed: Dispute has been closed."
  class="relative inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border cursor-help group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 bg-gray-100 text-gray-700 border-gray-200  "
  data-testid="dispute-badge-CLOSED"
  role="status"
  tabindex="0"
>
  <svg
    aria-hidden="true"
    class="lucide lucide-lock h-3 w-3 mr-1"
    fill="none"
    height="24"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    width="24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      height="11"
      rx="2"
      ry="2"
      width="18"
      x="3"
      y="11"
    />
    <path
      d="M7 11V7a5 5 0 0 1 10 0v4"
    />
  </svg>
  Closed
  <span
    class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max max-w-xs px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity pointer-events-none z-10 text-center whitespace-normal"
    role="tooltip"
  >
    Dispute has been closed.
    <span
      class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900"
    />
  </span>
</span>
`;

