# PetAd Frontend — Environment Variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables are optional — the app falls back to sensible
# defaults (shown here) when a variable is not set.

# ── Backend API ──────────────────────────────────────────────────────────────

# Base URL of the PetAd backend REST API.
# Default: "http://localhost:3000/api" (or "/api" when VITE_MSW=true).
# Point it at staging to run against the staging backend:
VITE_API_URL=https://api.staging.petad.example.com/api

# ── Real-time notifications (Phase 3) ────────────────────────────────────────

# WebSocket endpoint for real-time notifications. When unset, the app
# derives the URL from the current origin as:
#   ws(s)://<host>/api/ws/notifications?token=<auth_token>
# Set this to override the derivation, e.g.:
VITE_WEBSOCKET_URL=wss://api.staging.petad.example.com/api/ws/notifications

# ── Mock Service Worker (MSW) ────────────────────────────────────────────────

# Set to "true" to serve mock API responses via MSW instead of a live backend.
# Used for local development and E2E tests without the backend running.
VITE_MSW=false

# ── Stellar trust layer ──────────────────────────────────────────────────────

# Stellar network used to build transaction explorer links.
# Accepts "testnet" (default) or "mainnet".
VITE_STELLAR_NETWORK=testnet

# Public key of the current user, used by the settlement summary demo page.
# Mainly for demos/tests; normally the key comes from the authenticated user.
VITE_STELLAR_PUBLIC_KEY=G_MOCK_USER_PUBLIC_KEY
