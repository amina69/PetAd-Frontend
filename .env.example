# PetAd Frontend — Environment Variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables are optional — the app falls back to sensible
# defaults (shown here) when a variable is not set.

# ── Backend API ──────────────────────────────────────────────────────────────

# Base URL of the PetAd backend REST API.
# Default: "http://localhost:3000/api" (or "/api" when VITE_MSW=true).
# Point it at staging to run against the staging backend:
VITE_API_URL=https://api.staging.petad.example.com/api

# ── Real-time notifications (Phase 3) ────────────────────────────────────────

# WebSocket endpoint for real-time notifications. When unset, the app
# derives the URL from the current origin as:
#   ws(s)://<host>/api/ws/notifications?token=<auth_token>
# Set this to override the derivation, e.g.:
VITE_WEBSOCKET_URL=wss://api.staging.petad.example.com/api/ws/notifications

# Optional product analytics. Set per deployment environment; analytics remain
# disabled unless the application adds/configures an analytics provider.
VITE_ENABLE_ANALYTICS=false

# ── Mock Service Worker (MSW) ────────────────────────────────────────────────

# Set to "true" to serve mock API responses via MSW instead of a live backend.
# Used for local development and E2E tests without the backend running.
VITE_MSW=false

# ── Stellar trust layer ──────────────────────────────────────────────────────

# Stellar network used to build transaction explorer links.
# Accepts "testnet" (default) or "mainnet".
VITE_STELLAR_NETWORK=testnet

# Public key of the current user, used by the settlement summary demo page.
# Mainly for demos/tests; normally the key comes from the authenticated user.
VITE_STELLAR_PUBLIC_KEY=G_MOCK_USER_PUBLIC_KEY

# ── Privacy-gated analytics ──────────────────────────────────────────────────

# Analytics and error reporting initialise ONLY when this is exactly "true".
# With anything else (or unset) the app makes no analytics network calls.
VITE_ENABLE_ANALYTICS=false

# Collector base URL (events go to <url>/events, scrubbed errors to <url>/errors).
# Only used when VITE_ENABLE_ANALYTICS=true. Without it, events are not sent.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/v1

# ── Error tracking and release metadata ──────────────────────────────────────

# Sentry DSN. Error tracking initialises only when this is set AND
# VITE_ENABLE_ANALYTICS=true (the consent gate above). With either missing the
# app creates no client and makes no tracking network calls.
# VITE_SENTRY_DSN=https://publickey@o0.ingest.sentry.io/1

# Release id reported with every error. In CI this is the git SHA, and it must
# match the source maps uploaded for the same release (#779).
# VITE_RELEASE=

# Deployment environment shown in error reports, e.g. "staging" or "production".
# Falls back to Vite's mode ("development", "production").
# VITE_APP_ENV=development
