# PetAd frontend — environment template.
# Copy to `.env` (or `.env.local`) and adjust per environment:
#   cp env.example .env
# All VITE_ vars are validated at boot by src/lib/env.ts — the app
# refuses to start with a missing or malformed value.

# REQUIRED — Base URL of the PetAd backend API.
# Use "/api" together with VITE_MSW=true (mock service worker intercepts
# relative /api/* requests). Point at a real backend with an absolute URL:
#   VITE_API_URL=https://api.petad.example.com/api
VITE_API_URL=/api

# OPTIONAL — Enable the mock service worker in dev ("true" | "false").
VITE_MSW=true

# OPTIONAL — Stellar network used for explorer links ("testnet" | "mainnet").
VITE_STELLAR_NETWORK=testnet
